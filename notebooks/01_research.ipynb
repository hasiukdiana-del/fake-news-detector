    "rng = np.random.default_rng(config.SEED)\n",
    "boot = {\"accuracy DNN\": [], \"F1 DNN\": [], \"різниця accuracy (DNN - базова)\": []}\n",
    "for _ in range(2000):\n",
    "    i = rng.integers(0, len(y_test), len(y_test))\n",
    "    boot[\"accuracy DNN\"].append(ok_d[i].mean())\n",
    "    boot[\"F1 DNN\"].append(f1_score(y_test[i], pred[\"dnn\"][i]))\n",
    "    boot[\"різниця accuracy (DNN - базова)\"].append(ok_d[i].mean() - ok_b[i].mean())\n",
    "ci = pd.DataFrame({k: np.percentile(v, [2.5, 97.5]) for k, v in boot.items()}, index=[\"нижня межа\", \"верхня межа\"])\n",
    "R[\"CI_ACC\"] = ci[\"accuracy DNN\"].tolist()\n",
    "R[\"CI_F1\"] = ci[\"F1 DNN\"].tolist()\n",
    "R[\"CI_DIFF\"] = ci[\"різниця accuracy (DNN - базова)\"].tolist()\n",
