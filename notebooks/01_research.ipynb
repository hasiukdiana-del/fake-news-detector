    "err = test.assign(p_fake=scores[\"dnn\"], pred=pred[\"dnn\"])\n",
    "wrong = err[err.pred != err.label].assign(впевненість=lambda d: (d.p_fake - .5).abs())\n",
    "R[\"N_ERR\"] = len(wrong)\n",
    "print(f\"Помилок: {len(wrong)} з {len(err)}\")\n",
