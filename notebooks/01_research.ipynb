    "from scipy.stats import binomtest\n",
    "from sklearn.metrics import f1_score\n",
    "\n",
    "pred = {k: (v >= .5).astype(int) for k, v in scores.items()}\n",
    "ok_b, ok_d = pred[\"baseline\"] == y_test, pred[\"dnn\"] == y_test\n",
    "rows = {}\n",
    "for label, mask in ((\"усі статті (accuracy)\", np.ones_like(y_test, bool)), (\"фейкові статті (recall)\", y_test == 1)):\n",
    "    only_b, only_d = int((ok_b & ~ok_d & mask).sum()), int((~ok_b & ok_d & mask).sum())\n",
    "    rows[label] = {\"правильно лише базова\": only_b, \"правильно лише DNN\": only_d,\n",
    "                   \"p\": binomtest(min(only_b, only_d), only_b + only_d, .5).pvalue}\n",
    "mc = pd.DataFrame(rows).T\n",
    "R.update(MC_ALL_B=int(mc.iloc[0, 0]), MC_ALL_D=int(mc.iloc[0, 1]), MC_ALL_P=float(mc.iloc[0, 2]),\n",
    "         MC_FAKE_B=int(mc.iloc[1, 0]), MC_FAKE_D=int(mc.iloc[1, 1]), MC_FAKE_P=float(mc.iloc[1, 2]))\n",
    "mc.astype({\"правильно лише базова\": int, \"правильно лише DNN\": int}).round({\"p\": 4})"
   ],
