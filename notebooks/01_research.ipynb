    "from sklearn.feature_extraction.text import CountVectorizer\n",
    "cv = CountVectorizer(min_df=20, stop_words=\"english\")\n",
    "X = cv.fit_transform(train[\"clean\"])\n",
    "fake_c = np.asarray(X[train.label.values == 1].sum(0)).ravel() + 1\n",
    "real_c = np.asarray(X[train.label.values == 0].sum(0)).ravel() + 1\n",
    "log_odds = np.log(fake_c / fake_c.sum()) - np.log(real_c / real_c.sum())\n",
    "top = pd.DataFrame({\"слово\": cv.get_feature_names_out(), \"log-odds\": log_odds}).sort_values(\"log-odds\")\n",
    "pd.concat([top.head(10).assign(клас=\"real\"), top.tail(10).assign(клас=\"fake\")]).round(2).reset_index(drop=True)"
